    "permission_notifications_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress, speed and time left are shown in the notification bar. Without this permission downloads still run, but you will not see them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행률, 속도, 남은 시간을 알림바에 표시합니다. 권한이 없어도 다운로드는 되지만 상태가 보이지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行率、速度、残り時間を通知バーに表示します。許可しなくてもダウンロードは動きますが、状態は見えません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El progreso, la velocidad y el tiempo restante se muestran en la barra de notificaciones. Sin este permiso las descargas siguen, pero no las verás."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进度、速度和剩余时间会显示在通知栏。没有此权限下载仍会进行，但你看不到状态。"
          }
        }
      }
