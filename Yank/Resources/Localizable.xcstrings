    "settings_keep_open_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS pauses apps in the background. Keep Yank open while downloading."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 백그라운드 앱을 멈춰요. 받는 동안에는 Yank 를 열어 두세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSはバックグラウンドのアプリを停止します。ダウンロード中はYankを開いたままにしてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS pausa las apps en segundo plano. Mantén Yank abierta mientras descarga."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会暂停后台应用。下载时请保持 Yank 在前台。"
          }
        }
      }
    },
