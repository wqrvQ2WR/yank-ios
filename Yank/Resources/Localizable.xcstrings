            "state": "translated",
            "value": "Auto-download new videos"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 영상 자동 다운로드"
          }
        }
      }
    },
    "sub_auto_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked when you open Yank (about once an hour). Videos already there when you subscribe are skipped."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Yank 를 열 때 확인해요(약 1시간에 한 번). 구독 전에 올라와 있던 영상은 받지 않아요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Yankを開いたときに確認します(約1時間に1回)。登録前の動画は取得しません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se comprueba al abrir Yank (cada hora aprox.). Los vídeos anteriores a la suscripción se omiten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Yank 时检查(约每小时一次)。订阅前已有的视频不会下载。"
          }
        }
      }
    },
    "sub_battery_allow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용"
          }
        }
