            "value": "No folder is set, so files stay in the app's private storage. Pick a folder in Settings to keep them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 폴더가 없어 앱 내부에만 보관됩니다. 설정에서 폴더를 지정하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存フォルダが未設定のため、アプリ内部にのみ保存されます。設定でフォルダを指定してください。"
          }
        },
        "es": {
          "stringUnit": {
