    "error_blocked_no_server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube blocked this video for direct download. Set up the Yank server in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유튜브가 이 영상의 직접 받기를 막았어요. 설정에서 Yank 서버를 연결하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTubeがこの動画の直接ダウンロードを拒否しました。設定でYankサーバーを接続してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube bloqueó la descarga directa de este vídeo. Configura el servidor Yank en Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YouTube 阻止了此视频的直接下载。请在设置中连接 Yank 服务器。"
          }
        }
      }
    },
