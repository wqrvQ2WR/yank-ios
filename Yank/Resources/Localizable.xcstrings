    "settings_server_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A server you run (yank-pi) downloads with yt-dlp and sends the file back. Needs Tailscale on this iPhone when away from home."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 돌리는 서버(yank-pi)가 yt-dlp 로 받아서 파일을 보내 줘요. 밖에서는 이 iPhone 에서 테일스케일을 켜 둬야 해요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で動かすサーバー(yank-pi)がyt-dlpでダウンロードしてファイルを送ります。外出先ではこのiPhoneでTailscaleをオンにしてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un servidor propio (yank-pi) descarga con yt-dlp y envía el archivo. Fuera de casa necesitas Tailscale activo en este iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己运行的服务器(yank-pi)用 yt-dlp 下载并回传文件。外出时需在此 iPhone 上开启 Tailscale。"
          }
        }
      }
    },
