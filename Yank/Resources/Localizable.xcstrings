    "empty_queue_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a link on the Download tab to get started."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 탭에서 링크를 붙여넣어 시작하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードタブでリンクを貼り付けてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega un enlace en la pestaña Descargar para empezar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下载页粘贴链接即可开始。"
          }
        }
      }
    },
    "engine_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
