    },
    "sub_battery_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without this, Android may block downloads from starting while Yank is closed. Allow Yank to ignore battery optimization."
          }
        },
        "ko": {
