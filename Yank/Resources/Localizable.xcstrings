    "settings_save_to_gallery": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also add to gallery"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "갤러리에도 등록"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ギャラリーにも登録"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir también a la galería"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时加入相册"
          }
        }
      }
    },
    "settings_save_to_gallery_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register finished files in Movies or Music so the gallery and music apps can see them"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 파일을 Movies 또는 Music에 등록해 갤러리·음악 앱에서 보이게 합니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了したファイルを Movies または Music に登録します"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra los archivos en Movies o Music para que la galería y los reproductores los vean"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把完成的文件登记到 Movies 或 Music，相册和音乐应用即可看到"
          }
        }
      }
    },
    "settings_save_to_photos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also save videos to Photos"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 앱에도 저장"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真アプリにも保存"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar también en Fotos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时保存到照片"
          }
        }
      }
    },
    "settings_save_to_photos_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are always kept in the Files app under On My iPhone > Yank. Videos can also be added to Photos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 항상 파일 앱의 나의 iPhone > Yank 에 보관됩니다. 영상은 사진 앱에도 넣을 수 있어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは常にファイルアプリの「このiPhone内 > Yank」に保存されます。動画は写真アプリにも追加できます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos siempre se guardan en la app Archivos, en En mi iPhone > Yank. Los vídeos también pueden ir a Fotos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件始终保存在“文件”App 的“我的 iPhone > Yank”中。视频还可以添加到照片。"
          }
        }
      }
    },
    "settings_sdcard_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick any folder, including one on an SD card. Android grants write access to the folder you choose here, and the permission is kept after a restart."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SD카드 안쪽 폴더도 고를 수 있습니다. 여기서 선택한 폴더에만 쓰기 권한이 주어지고, 재부팅 후에도 권한이 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SDカード内のフォルダも選べます。選んだフォルダにのみ書き込み権限が付与され、再起動後も保持されます。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes elegir cualquier carpeta, también en una tarjeta SD. Android concede permiso de escritura solo a la carpeta elegida y lo mantiene tras reiniciar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以选择任意文件夹，包括 SD 卡上的。系统只对所选文件夹授予写入权限，重启后仍然有效。"
          }
        }
      }
    },
    "settings_server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yank server (for blocked videos)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Yank 서버 (막힌 영상용)"
          }
