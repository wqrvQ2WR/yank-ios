    "settings_engine_desc": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update yt-dlp itself. Do this when a site stops working."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp 자체를 갱신합니다. 특정 사이트가 갑자기 안 되면 실행해 보세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "yt-dlp 本体を更新します。特定のサイトが急に使えなくなったときに実行してください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza yt-dlp. Hazlo si un sitio deja de funcionar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新 yt-dlp 本体。某个网站突然不能用时可以试试。"
          }
        }
      }
    },
